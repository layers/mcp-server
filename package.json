{
  "name": "@layers/mcp-server",
  "version": "1.1.0",
  "description": "MCP server exposing the Layers API as tools",
  "author": "Layers AI, Inc.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/layers/mcp-server#readme",
  "repository": { "type": "git", "url": "git+https://github.com/layers/mcp-server.git" },
  "bugs": { "url": "https://github.com/layers/mcp-server/issues" },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "layers",
    "partner-api",
    "ai-agents",
    "stdio",
    "social-media",
    "content-generation"
  ],
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "layers-mcp-server": "dist/index.js" },
  "files": ["dist", "NOTICE"],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3"
  }
}